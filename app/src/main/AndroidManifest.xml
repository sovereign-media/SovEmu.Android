<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Identify rumbles a controller that has no lights to blink. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The low-latency Wi-Fi lock held while a game is on screen (LowLatency.kt). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Gamepads are optional: the player has a touch controller. -->
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!--
      usesCleartextTraffic: a SovEmu server on a home network is usually plain HTTP
      (http://192.168.x.y:8080). Media is always encrypted (DTLS-SRTP) regardless.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/banner"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:usesCleartextTraffic="true"
        android:isGame="true"
        android:appCategory="game">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|fontScale|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTask">
            <!-- One instance: launchers open it with different categories (Fire TV's home with
                 LEANBACK_LAUNCHER, others with LAUNCHER), and with the default launch mode each
                 new one was stacked over the last, which went on running out of sight. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- The Android TV home screen lists apps by this, with their banner. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
