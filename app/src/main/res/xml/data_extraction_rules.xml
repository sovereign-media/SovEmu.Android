<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing this app stores leaves the device, as in Sovereign's app. The manifest names this file
  as android:dataExtractionRules, backup_rules.xml as android:fullBackupContent (API 26-30), and
  also sets android:allowBackup="false".

  The rules are needed as well as the flag: allowBackup="false" turns off cloud backup on every
  API level, and device-to-device transfer up to API 30, but from API 31 it no longer covers
  device transfer, so a new phone set up from an old one would copy the app's data. What would
  be copied is the server address, its sign-in settings, the device name and the sealed refresh
  token (which cannot be opened elsewhere, its Keystore key not being exportable, but there is no
  reason to copy it either). Every domain is excluded, so anything stored later is covered too.
-->
<data-extraction-rules>
  <cloud-backup>
      <exclude domain="root" path="." />
      <exclude domain="file" path="." />
      <exclude domain="database" path="." />
      <exclude domain="sharedpref" path="." />
      <exclude domain="external" path="." />
      <exclude domain="device_root" path="." />
      <exclude domain="device_file" path="." />
      <exclude domain="device_database" path="." />
      <exclude domain="device_sharedpref" path="." />
  </cloud-backup>
  <device-transfer>
      <exclude domain="root" path="." />
      <exclude domain="file" path="." />
      <exclude domain="database" path="." />
      <exclude domain="sharedpref" path="." />
      <exclude domain="external" path="." />
      <exclude domain="device_root" path="." />
      <exclude domain="device_file" path="." />
      <exclude domain="device_database" path="." />
      <exclude domain="device_sharedpref" path="." />
  </device-transfer>
</data-extraction-rules>
