<?xml version="1.0" encoding="utf-8"?>
<!-- Amazon Fire TV: the Android TV app with a manifest for Fire OS. Permissions come from :common:feature's manifest. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Not required: some Fire TV devices report leanback inconsistently, and the app must
         install on all of them. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!--
      usesCleartextTraffic: a SovEmu server on a home network is usually plain HTTP
      (http://192.168.x.y:8080). Media is always encrypted (DTLS-SRTP) regardless.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/banner"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:usesCleartextTraffic="true"
        android:isGame="true"
        android:appCategory="game">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|fontScale|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTask">
            <!-- One instance: launchers open it with different categories (Fire TV's home with
                 LEANBACK_LAUNCHER, others with LAUNCHER), and with the default launch mode each
                 new one was stacked over the last, which went on running out of sight. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Fire TV's home lists apps by this. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
