<?xml version="1.0" encoding="utf-8"?>
<!-- Phones and tablets: touch, the touch controller, the browser sign-in. Permissions come from :common:feature's manifest. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- A tablet with a keyboard and no touch screen still installs it. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!--
      usesCleartextTraffic: a SovEmu server on a home network is usually plain HTTP
      (http://192.168.x.y:8080). Media is always encrypted (DTLS-SRTP) regardless.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:usesCleartextTraffic="true"
        android:isGame="true"
        android:appCategory="game">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|fontScale|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTask">
            <!-- One instance: a second launch reuses it rather than stacking another. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The browser sign-in, as Sovereign's phones do it, declared only here so neither TV app
          registers the redirect scheme. BrowserSignInActivity opens the Custom Tab and waits:
          singleTask, so a redirect from a full browser's own task brings it forward; not
          exported. BrowserRedirectActivity takes the redirect,
          media.sovereign.sovemu:/oauth2redirect, the mobile client's redirect URI: exported, so a
          browser can open it. The filter names the scheme alone (the URI has no host, and
          Android ignores a path filter without one); the state and the code are checked against
          the request, so a stray URI on the scheme is refused there.
        -->
        <activity
            android:name="media.sovereign.sovemu.BrowserSignInActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:name="media.sovereign.sovemu.BrowserRedirectActivity"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="media.sovereign.sovemu" />
            </intent-filter>
        </activity>
    </application>
</manifest>
